  "expert_defs": [
    {
      "name": "exchange_historical_rate",
      "description": "Uses Frankfurter API (ECB data) — get historical exchange rates for any date, inspired by currency libraries used in finance apps.",
      "cspl": "fython",
      "kwargs": {
        "date": "",
        "from_currency": "USD",
        "to_currency": "EUR"
      },
      "code": [
        "def exchange_historical_rate(date='', from_currency='USD', to_currency='EUR'):",
        "    import urllib.request, json",
        "    try:",
        "        frm, to = from_currency.upper().strip(), to_currency.upper().strip()",
        "        url = 'https://api.frankfurter.app/'+date.strip()+'?from='+frm+'&to='+to",
        "        req = urllib.request.Request(url, headers={'User-Agent': 'ExtellaTool/1.0'})",
        "        with urllib.request.urlopen(req, timeout=10) as r: data = json.loads(r.read().decode())",
        "        rate = data['rates'].get(to)",
        "        return json.dumps({'status':'success','output_type':'json','data':{'date':data.get('date'),'from':frm,'to':to,'rate':rate}})",
        "    except Exception as e: return json.dumps({'status':'error','message':str(e)})"
      ]
    }
  ],
  "conceptTexts": [
