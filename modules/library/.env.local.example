# Copy this file to `.env.local` for local `npm run dev`.
# `.env.local` is gitignored.
#
# Only VITE_MB_TOKEN is required — the rest already have sensible defaults
# baked into the bundle (see src/lib/runtime.ts).
#
# Values below mirror the corresponding MAIN_BACKEND_* entries from the
# repo-root `.env`. Dev-only: production (Electron) builds get the token
# from window.__MB_TOKEN__ injected by the preload bridge instead.

VITE_MB_TOKEN=

# Optional overrides — uncomment if you need to point at a non-default
# Extella deployment or a different profile/agent.
# VITE_MB_BASE_URL=https://api.extella.ai
# VITE_MB_PROFILE_ID=default
# VITE_MB_AGENT_ID=agent_extella_default
