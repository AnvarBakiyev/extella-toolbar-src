{
  "name": "@extella/library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Library module — admin-panel SPA embedded into the Extella toolbar. Talks directly to the Main Backend (Extella) API using a token injected at runtime via window.__MB_TOKEN__ (set by the toolbar's <head> hash shim).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
