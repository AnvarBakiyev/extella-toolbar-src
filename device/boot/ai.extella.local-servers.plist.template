<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.extella.local-servers</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__HOME__/extella-plugins/_boot/restart_local_servers.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Also re-check every 10 min: idempotent, recovers crashed servers too. -->
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>__HOME__/extella-plugins/_boot/launchagent.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/extella-plugins/_boot/launchagent.err.log</string>
</dict>
</plist>
