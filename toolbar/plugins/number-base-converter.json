  "expert_defs": [
    {
      "name": "number_base_converter_convert",
      "description": "Converts an integer from one base to all other bases. Params: number (string representation of number), from_base (2/8/10/16, default 10). Returns JSON with output_type json showing decimal, binary, octal and hex values.",
      "cspl": "fython",
      "kwargs": {
        "number": "0",
        "from_base": "10"
      },
      "code": [
        "def number_base_converter_convert(number='0', from_base='10'):",
        "    import json",
        "    try:",
        "        n = int(number.strip(), int(from_base))",
        "        result = {",
        "            'decimal':     str(n),",
        "            'binary':      bin(n)[2:],",
        "            'octal':       oct(n)[2:],",
        "            'hexadecimal': hex(n)[2:].upper()",
        "        }",
        "        return json.dumps({'status': 'success', 'output_type': 'json', 'data': result})",
        "    except Exception as e:",
        "        return json.dumps({'status': 'error', 'message': str(e)})"
      ]
    }
  ],
  "conceptTexts": [
    "Plugin: Number Base Converter (id: number-base-converter). Expert number_base_converter_convert converts integers between decimal, binary, octal, and hexadecimal. Params: number (string), from_base (2/8/10/16). Returns {output_type: 'json', data: {decimal, binary, octal, hexadecimal}}."
  ]
