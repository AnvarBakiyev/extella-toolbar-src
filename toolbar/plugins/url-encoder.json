              "label": "Decode (%XX → text)"
            }
          ]
        },
        {
          "name": "mode",
          "type": "select",
          "label": "Mode",
          "required": false,
          "default": "component",
          "options": [
            {
              "value": "component",
              "label": "Component (encode spaces, &, = etc.)"
            },
            {
              "value": "full",
              "label": "Full URL (preserve ://?=& structure)"
            }
          ]
        }
      ],
      "outputs": [
        {
          "type": "text"
        }
      ]
    }
  ],
  "expert_defs": [
    {
      "name": "url_encoder_convert",
      "description": "Percent-encodes or decodes URL strings. Params: text (input string), operation (encode/decode), mode (component encodes everything except unreserved chars; full preserves URL structure). Returns JSON with output_type text.",
      "cspl": "fython",
      "kwargs": {
        "text": "",
        "operation": "encode",
        "mode": "component"
      },
      "code": [
        "def url_encoder_convert(text='', operation='encode', mode='component'):",
        "    import urllib.parse, json",
        "    try:",
        "        if operation == 'encode':",
        "            if mode == 'full':",
        "                result = urllib.parse.quote(text, safe=':/?#[]@!$&\\'()*+,;=')",
        "            else:",
        "                result = urllib.parse.quote(text, safe='')",
        "        else:",
        "            result = urllib.parse.unquote(text)",
        "        return json.dumps({'status': 'success', 'output_type': 'text', 'data': result})",
        "    except Exception as e:",
        "        return json.dumps({'status': 'error', 'message': str(e)})"
      ]
    }
  ],
  "conceptTexts": [
    "Plugin: URL Encoder/Decoder (id: url-encoder). Expert url_encoder_convert percent-encodes or decodes URLs. Params: text, operation (encode/decode), mode (component/full). Returns {output_type: 'text', data: '<result>'}."
  ]
